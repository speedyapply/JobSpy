# hours between searches
INTERVAL_HOURS=6
# seconds between two InfoJobs requests: a fixed 4, or 3-6 for a random pause
INFOJOBS_DELAY=3-6
# seconds between two searches of searches.json
SEARCH_PAUSE=5-15
# the app sends this as "Authorization: Bearer <token>"; make one with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
API_TOKEN=
# port on this machine, and the address it listens on: 0.0.0.0 for every network,
# or your Tailscale IP (tailscale ip -4) to accept only your tailnet
API_PORT=8000
API_BIND=0.0.0.0
